# Copy to .env. Never commit .env.
# The openai SDK reads OPENAI_BASE_URL and OPENAI_API_KEY automatically.

# Local development: Ollama's OpenAI-compatible endpoint (the key is ignored but must be non-empty)
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
MODEL=gpt-oss:20b

# Real OpenAI later: delete OPENAI_BASE_URL, set a real key, and pick a model
# OPENAI_API_KEY=sk-...
# MODEL=<openai model name>
